# Content Credentials — environment configuration.
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.

# Shared Bearer token between the PHP client and the Node signing service.
# Must match the value the service is started with. Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTENTAUTH_API_KEY=

# Base URL of the signing service (see service/, docker compose exposes :3000).
CONTENTAUTH_SERVICE_URL=http://localhost:3000

# Rate limiting and concurrency bounds (SPEC-015). On by default — a protection
# that ships off is one nobody turns on. Setting a limit to 0 disables it
# explicitly, and GET /health reports that, so an unprotected instance is
# visible rather than assumed safe. Excess requests get 429 + Retry-After;
# the service refuses rather than queues, because the PHP client bounds a
# request at 10s and a queued request would time out client-side while still
# holding a slot here.
# MAX_CONCURRENT_SIGNS=4
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_MS=60000
# REQUEST_TIMEOUT_MS=15000
# HEADERS_TIMEOUT_MS=10000

# Assertion limits enforced by the signing service (SPEC-011). The structural
# limits are restrictive by default — leave them unless you have a reason.
# MAX_ASSERTIONS=16
# MAX_ASSERTION_BYTES=65536
# MAX_ASSERTION_DEPTH=16
# MAX_CREATOR_NAME=256

# Semantic policy, deliberately the OTHER way round: off by default. The service
# takes no position on digitalSourceType, because requiring
# trainedAlgorithmicMedia cannot make an attestation truer (it can be verified no
# better than a camera-capture claim) while excluding the authenticity use case
# entirely. Set to true only if this certificate exists solely to mark
# AI-generated content.
# REQUIRE_AI_MARKING=true

# Optional salt for the audit log's token_id (SPEC-012). Unset => a per-process
# salt, which still correlates requests within one run; set it to keep token_id
# values stable across restarts. Never logged; treat it as a secret.
# CONTENTAUTH_TOKEN_ID_SALT=

# Optional c2pa trust settings for the signing service (SPEC-014). Unset/empty
# => no trust-list verification: a signed asset reads back as "Valid" with
# signingCredential.untrusted, and ManifestReport::isTrusted() is false BY
# DESIGN, whatever certificate signed it. Point this at a settings document to
# switch verification on; docker-compose mounts the bundled TEST anchors at the
# path below. Replace them for production — these trust only test certificates.
# The service refuses to start if the document is unreadable, does not parse, or
# could not actually verify (verify_trust plus trust_anchors/allowed_list), so a
# misconfiguration cannot leave you believing trust is on when it is not.
# CONTENTAUTH_TRUST_SETTINGS=/run/secrets/c2pa-trust.settings.json

# Optional RFC 3161 Time Stamping Authority for the signing service (SPEC-007).
# Unset/empty => signatures carry no trusted timestamp (default). When set, the
# service timestamps every signature and fails the request if the TSA is
# unreachable. A timestamp's TRUST still depends on the TSA's certificate chain.
# CONTENTAUTH_TSA_URL=http://timestamp.digicert.com
