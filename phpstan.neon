parameters:
    level: max
    paths:
        - src
        - tests
    ignoreErrors:
        # Test-only false positive (SPEC-004 D4 / SPEC-006 D5). The Laravel tests use
        # a bare Illuminate\Container\Container as a lightweight harness, because
        # orchestra/testbench is not installable here (it pulls laravel/framework,
        # which replaces our pinned illuminate/support and is blocked by security
        # advisories). Framework APIs — ServiceProvider::__construct(),
        # Facade::setFacadeApplication(), Command::setLaravel() — are phpdoc-typed for
        # the Application contract but accept any container at runtime, so a plain
        # container is valid (the tests pass). This does NOT relax analysis of product
        # code — src/ stays strict; the scope is one identifier in the Laravel tests.
        -
            message: '#expects Illuminate\\Contracts\\Foundation\\Application(\|null)?, .+ given\.#'
            identifier: argument.type
            path: tests/Unit/Laravel/*
